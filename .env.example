# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=pulseflow
DB_URL=jdbc:postgresql://localhost:35432/pulseflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=notif
POSTGRES_PORT=35432

# ── JPA / Flyway ──────────────────────────────────────────────────────────────
JPA_DDL_AUTO=validate
JPA_FORMAT_SQL=false
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=pulseflow.events
RABBITMQ_QUEUE=pulseflow.events.queue
RABBITMQ_DLQ=pulseflow.events.dlq
RABBITMQ_DELIVERY_ASYNC=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
# Use localhost so the admin UI does not redirect to http://keycloak:8080 (NXDOMAIN on your PC)
KC_HOSTNAME=localhost
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/pulseflow
KEYCLOAK_ISSUER_URI_DOCKER=http://localhost:8080/realms/pulseflow
KEYCLOAK_POSTMAN_CLIENT_ID=pulseflow-postman
KEYCLOAK_POSTMAN_CLIENT_SECRET=pulseflow-postman-secret

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── SMTP / Mail ───────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@pulseflow.local

# ── Integrations ──────────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8081/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=pulseflow
VITE_KEYCLOAK_CLIENT_ID=pulseflow-frontend
# Optional: bypass Keycloak login for local/API tests only
VITE_JWT_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
